{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 400,
  "data": {
    "url": "clean_ee_exports_trend.csv"
  },
  "mark": {
    "type": "area",
    "line": {
      "color": "#1f77b4"
    },
    "color": {
      "x1": 1,
      "y1": 1,
      "x2": 1,
      "y2": 0,
      "gradient": "linear",
      "stops": [
        {
          "offset": 0,
          "color": "white"
        },
        {
          "offset": 1,
          "color": "#1f77b4"
        }
      ]
    }
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "temporal",
      "axis": {
        "title": "Year",
        "grid": false
      }
    },
    "y": {
      "field": "exports",
      "type": "quantitative",
      "axis": {
        "title": "Export Value (RM Million)",
        "format": "s"
      }
    },
    "tooltip": [
      {
        "field": "year",
        "type": "temporal",
        "title": "Year",
        "timeUnit": "year"
      },
      {
        "field": "exports",
        "type": "quantitative",
        "title": "Total Exports (RM)",
        "format": ","
      }
    ]
  }
}